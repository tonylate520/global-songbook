---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = "Who sang it first? Search original recordings, cover artists, and international song versions across 130+ countries.",
  keywords = "who sang it first, song cover versions, original artist database, who covered this song, song cover finder, music catalog by country, cover songs list, original vs cover, international music archive",
  noindex = false,
  schema = []
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const canonicalHref = canonical?.toString();
const siteUrl = Astro.site?.toString().replace(/\/$/, "") || "https://kugou9.com";
const robots = noindex ? "noindex,follow" : "index,follow,max-image-preview:large";
const extraSchemas = Array.isArray(schema) ? schema : [schema];

const structuredData = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Global Song Index",
    alternateName: ["Global Songbook", "Who Sang It First Database"],
    url: siteUrl,
    description: "The international music archive tracing original song performers and global cover versions across countries.",
    potentialAction: {
      "@type": "SearchAction",
      target: `${siteUrl}/search/?q={search_term_string}`,
      "query-input": "required name=search_term_string"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    description,
    url: canonicalHref
  },
  ...extraSchemas
].filter(Boolean)).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <meta name="theme-color" content="#102a2b" />
    <meta name="author" content="Global Song Index" />
    <meta property="og:site_name" content="Global Song Index" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalHref && <meta property="og:url" content={canonicalHref} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {canonicalHref && <link rel="canonical" href={canonicalHref} />}
    {canonicalHref && <link rel="alternate" hreflang="en" href={canonicalHref} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600&display=swap" rel="stylesheet" />
    <script id="page-schema" is:inline type="application/ld+json" set:html={structuredData}></script>
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="Global Song Index home">
          <span class="brand-mark" aria-hidden="true">
            <i data-lucide="disc-3"></i>
          </span>
          <span class="brand-text">
            <strong class="brand-name">Global Song Index</strong>
            <span class="brand-edition">ORIGINALS & COVERS ARCHIVE</span>
          </span>
        </a>
        <nav class="top-nav" aria-label="Main navigation">
          <a href="/countries/" class="nav-link">
            <i data-lucide="globe-2"></i>
            <span>Countries</span>
          </a>
          <a href="/search/" class="nav-link">
            <i data-lucide="search"></i>
            <span>Search</span>
          </a>
          <a href="/about/" class="nav-link">
            <i data-lucide="info"></i>
            <span>About</span>
          </a>
        </nav>
        <div class="header-actions">
          <a class="header-quick-search" href="/search/" aria-label="Quick search songs or artists">
            <i data-lucide="search"></i>
            <span class="quick-search-placeholder">Search songs, artists...</span>
            <kbd class="shortcut-key">/</kbd>
          </a>
        </div>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-shell">
        <div class="footer-grid">
          <div class="footer-brand-col">
            <div class="footer-brand">
              <span class="brand-mark" aria-hidden="true"><i data-lucide="disc-3"></i></span>
              <strong>Global Song Index</strong>
            </div>
            <p class="footer-tagline">
              The premier open music encyclopedia tracking who sang it first, original recording credits, and global cover versions across 130+ nations.
            </p>
            <div class="footer-badges">
              <span class="badge-pill"><i data-lucide="music-2"></i> 4,400+ Songs</span>
              <span class="badge-pill"><i data-lucide="mic-2"></i> 33,000+ Artists</span>
              <span class="badge-pill"><i data-lucide="globe-2"></i> 130+ Countries</span>
            </div>
          </div>

          <div class="footer-col">
            <h3 class="footer-heading">Major Music Hubs</h3>
            <ul class="footer-links">
              <li><a href="/country/us/">United States</a></li>
              <li><a href="/country/gb/">United Kingdom</a></li>
              <li><a href="/country/fr/">France</a></li>
              <li><a href="/country/jp/">Japan</a></li>
              <li><a href="/country/de/">Germany</a></li>
              <li><a href="/country/kr/">South Korea</a></li>
              <li><a href="/country/cn/">China</a></li>
              <li><a href="/country/br/">Brazil</a></li>
              <li><a href="/countries/" class="footer-all-link">View all 133 countries &rarr;</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <h3 class="footer-heading">Music Discovery</h3>
            <ul class="footer-links">
              <li><a href="/search/">Search Song Database</a></li>
              <li><a href="/countries/">Browse by Country</a></li>
              <li><a href="/#showcase">Cross-Border Cover Stories</a></li>
              <li><a href="/#faq">Original vs. Cover FAQ Guide</a></li>
              <li><a href="/about/">About Global Song Index</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <h3 class="footer-heading">Song Attributions</h3>
            <p class="footer-info-text">
              Performance data and relationship mappings are compiled from MusicBrainz, verified open public archives, and international discographies.
            </p>
            <div class="footer-status">
              <span class="status-dot"></span>
              <span>Catalog Active &bull; D1 Edge Replica</span>
            </div>
          </div>
        </div>

        <div class="footer-bottom">
          <p class="footer-copyright">&copy; 2026 Global Song Index &bull; kugou9.com. All rights reserved.</p>
          <div class="footer-sublinks">
            <a href="/about/">About</a>
            <a href="/search/">Search</a>
            <a href="/countries/">Countries</a>
          </div>
        </div>
      </div>
    </footer>

    <script>
      import {
        createIcons,
        ArrowLeft,
        ArrowRight,
        ArrowUpRight,
        AudioLines,
        CheckCircle2,
        ChevronRight,
        Disc3,
        Globe2,
        HelpCircle,
        Info,
        Layers,
        ListMusic,
        MapPin,
        Mic2,
        Music2,
        Radio,
        Search,
        Sparkles,
        TrendingUp,
        UserRound,
        X
      } from "lucide";

      createIcons({
        icons: {
          ArrowLeft,
          ArrowRight,
          ArrowUpRight,
          AudioLines,
          CheckCircle2,
          ChevronRight,
          Disc3,
          Globe2,
          HelpCircle,
          Info,
          Layers,
          ListMusic,
          MapPin,
          Mic2,
          Music2,
          Radio,
          Search,
          Sparkles,
          TrendingUp,
          UserRound,
          X
        }
      });

      // Quick search shortcut key ('/')
      window.addEventListener("keydown", (e) => {
        if (e.key === "/" && !["INPUT", "TEXTAREA"].includes((document.activeElement as HTMLElement)?.tagName)) {
          e.preventDefault();
          const searchInput = document.querySelector<HTMLInputElement>("input[type='search'], #search-input, .search-box input");
          if (searchInput) {
            searchInput.focus();
            searchInput.select();
          } else {
            window.location.href = "/search/";
          }
        }
      });
    </script>
  </body>
</html>
