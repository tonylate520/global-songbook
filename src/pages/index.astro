---
import BaseLayout from "../layouts/BaseLayout.astro";
import { countryList } from "../data/countries";
import manifest from "../../data/generated/catalog/manifest.json";

// Featured major music hubs
const majorCountryCodes = ["us", "gb", "fr", "de", "jp", "kr", "cn", "br", "ca", "au", "es", "it"];
const majorCountries = majorCountryCodes
  .map((code) => countryList.find((c) => c.code === code))
  .filter(Boolean);

// Trending search pills
const trendingSongs = [
  { title: "Hallelujah", query: "Hallelujah" },
  { title: "Hotel California", query: "Hotel California" },
  { title: "The Sound of Silence", query: "The Sound of Silence" },
  { title: "La Vie en rose", query: "La Vie en rose" },
  { title: "I Will Always Love You", query: "I Will Always Love You" },
  { title: "Despacito", query: "Despacito" },
  { title: "House of the Rising Sun", query: "House of the Rising Sun" },
  { title: "The Girl from Ipanema", query: "The Girl from Ipanema" },
  { title: "Killing Me Softly", query: "Killing Me Softly" },
  { title: "California Dreamin'", query: "California Dreamin'" }
];

// Curated Cross-Border Cover Showcases with direct song IDs
const showcases = [
  {
    id: 4,
    title: "Hallelujah",
    originalArtist: "Leonard Cohen",
    originalCountry: "Canada",
    originalCountryCode: "ca",
    year: 1984,
    summary: "From Leonard Cohen's 1984 folk original to immortal renditions by Jeff Buckley, John Cale, and artists across over 30 countries.",
    badge: "Most Covered Global Anthem"
  },
  {
    id: 1,
    title: "I Will Always Love You",
    originalArtist: "Dolly Parton",
    originalCountry: "United States",
    originalCountryCode: "us",
    year: 1974,
    summary: "Written and first recorded as a country ballad by Dolly Parton in 1974, transformed into an iconic pop powerhouse by Whitney Houston in 1992.",
    badge: "Iconic Vocal Transformation"
  },
  {
    id: 13,
    title: "La Vie en rose",
    originalArtist: "Édith Piaf",
    originalCountry: "France",
    originalCountryCode: "fr",
    year: 1945,
    summary: "Édith Piaf's signature 1945 French chanson celebrated worldwide across jazz, pop, and bossa nova in dozens of languages.",
    badge: "Timeless French Classic"
  },
  {
    id: 5,
    title: "The Sound of Silence",
    originalArtist: "Simon & Garfunkel",
    originalCountry: "United States",
    originalCountryCode: "us",
    year: 1964,
    summary: "Paul Simon's folk masterpiece, reimagined from quiet acoustic poetry into symphonic heavy metal by Disturbed and international orchestras.",
    badge: "Cross-Genre Evolution"
  },
  {
    id: 7,
    title: "Hotel California",
    originalArtist: "Eagles",
    originalCountry: "United States",
    originalCountryCode: "us",
    year: 1976,
    summary: "The 1976 rock milestone recorded by the Eagles, famously adapted into rumba flamenco by the Gipsy Kings and acoustic covers globally.",
    badge: "Global Rock Standard"
  },
  {
    id: 15,
    title: "Despacito",
    originalArtist: "Luis Fonsi & Daddy Yankee",
    originalCountry: "Puerto Rico",
    originalCountryCode: "pr",
    year: 2017,
    summary: "The Latin pop juggernaut that sparked cover versions, language adaptations, and acoustic interpretations in every continent.",
    badge: "Modern Streaming Phenomenon"
  }
];

// Long-Tail SEO FAQs for Google Rich Snippets & PAA
const faqList = [
  {
    q: "Who sang it first? How do you determine the original recording of a song?",
    a: "The original recording refers to the very first commercially released audio performance by the credited artist or group. In our database, release chronologies and discographical master records from MusicBrainz and international registries are analyzed to pinpoint the true first performer."
  },
  {
    q: "What is the difference between an original recording and a cover version?",
    a: "An original recording is the earliest recorded performance that introduced the song to the public. A cover version is any subsequent recording of that composition by a different artist or musical ensemble, whether performed in the same style or rearranged into new genres and languages."
  },
  {
    q: "How can I search for cover versions by country or language?",
    a: "You can browse by country through our Countries Directory to discover all song performances recorded by artists from that nation. Alternatively, search any song title to see a complete breakdown of every artist and country that has recorded a version."
  },
  {
    q: "Why do songs travel across borders and get covered internationally?",
    a: "Melodies and lyric themes often resonate across cultural borders. Famous songs like 'Hallelujah', 'La Vie en rose', and 'Hotel California' have been adapted into French, Spanish, Japanese, German, and Portuguese, reflecting the rich cross-pollination of international music history."
  }
];

const homeSchema = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqList.map((faq) => ({
      "@type": "Question",
      name: faq.q,
      acceptedAnswer: {
        "@type": "Answer",
        text: faq.a
      }
    }))
  }
];
---

<BaseLayout
  title="Global Song Index - Who Sang It First? Original Recordings & Global Cover Versions"
  description="Who sang it first? Search over 4,400 songs, 33,000 artists, and 114,000 recorded performances across 130+ countries. Find original singers, release years, and international cover versions."
  keywords="who sang it first, song cover versions, original singer database, who covered this song, song cover finder, music catalog by country, cover songs list, original vs cover, international music archive"
  schema={homeSchema}
>
  <!-- Hero Section -->
  <section class="hero-wrapper">
    <div class="page-shell hero-grid">
      <div class="hero-content">
        <p class="eyebrow">
          <i data-lucide="disc-3"></i> The Definitive Song & Cover Archive
        </p>
        <h1>Who Sang It First? Discover Originals & Global Covers</h1>
        <p class="lead">
          Explore over <strong>{manifest.songs.toLocaleString("en-US")}</strong> songs, <strong>{manifest.artists.toLocaleString("en-US")}</strong> performers, and <strong>{manifest.records.toLocaleString("en-US")}</strong> recorded versions across <strong>130+</strong> active music markets (250 territories indexed).
        </p>

        <!-- Search Bar -->
        <form class="search-box" action="/search/" method="get">
          <i data-lucide="search"></i>
          <input
            name="q"
            type="search"
            placeholder="Search song title, artist, or composer (e.g. Hallelujah, Dolly Parton)..."
            aria-label="Search song or artist name"
            required
            autocomplete="off"
          />
          <button type="submit">
            <i data-lucide="search"></i> Search Index
          </button>
        </form>

        <!-- Trending Search Pills -->
        <div class="trending-searches">
          <span class="trending-label">
            <i data-lucide="trending-up"></i> Trending Song Queries:
          </span>
          <div class="trending-pills">
            {trendingSongs.map((item) => (
              <a class="trending-pill" href={"/search/?q=" + encodeURIComponent(item.query)}>
                {item.title}
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Real-time Catalog Stats Card -->
      <div class="hero-stats-card">
        <div class="stats-card-header">
          <p class="eyebrow"><i data-lucide="sparkles"></i> Open Music Intelligence</p>
          <h3>International Catalogue Scale</h3>
          <p>Every recording indexed with country attribution and original vs. cover classification.</p>
        </div>
        <div class="hero-stats-grid">
          <div class="stat-item">
            <span class="stat-value">{manifest.songs.toLocaleString("en-US")}</span>
            <span class="stat-label">Songs Indexed</span>
          </div>
          <div class="stat-item">
            <span class="stat-value">{manifest.artists.toLocaleString("en-US")}</span>
            <span class="stat-label">Performers & Bands</span>
          </div>
          <div class="stat-item">
            <span class="stat-value">{manifest.records.toLocaleString("en-US")}</span>
            <span class="stat-label">Recorded Versions</span>
          </div>
          <div class="stat-item">
            <span class="stat-value">130+</span>
            <span class="stat-label">Active Nations</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Cross-Border Cover Journeys (Showcase) -->
  <section class="page-shell section" id="showcase">
    <div class="section-heading">
      <div>
        <p class="eyebrow"><i data-lucide="radio"></i> Featured Song Histories</p>
        <h2>Cross-Border Song Journeys</h2>
        <p class="section-subtext">Legendary songs and how they traveled across genres, languages, and continents.</p>
      </div>
      <a class="text-link" href="/search/">Search full index <i data-lucide="arrow-right"></i></a>
    </div>

    <div class="showcase-grid">
      {showcases.map((song) => (
        <article class="showcase-card">
          <span class="showcase-badge">
            <i data-lucide="sparkles"></i> {song.badge}
          </span>
          <h3 class="showcase-title">
            <a href={"/song/" + song.id + "/"}>{song.title}</a>
          </h3>
          <p class="showcase-desc">{song.summary}</p>
          <div class="showcase-meta">
            <span class="showcase-artist">
              Original: {song.originalArtist} ({song.year})
            </span>
            <a href={"/song/" + song.id + "/"} class="text-link">
              View covers <i data-lucide="arrow-right"></i>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Major Music Hubs by Country -->
  <section class="page-shell section" id="countries">
    <div class="section-heading">
      <div>
        <p class="eyebrow"><i data-lucide="globe-2"></i> National Discographies</p>
        <h2>Explore Songs by Country</h2>
        <p class="section-subtext">Browse artists and songs recorded in key music markets around the world.</p>
      </div>
      <a class="text-link" href="/countries/">Browse all 133 countries <i data-lucide="arrow-right"></i></a>
    </div>

    <div class="country-grid">
      {majorCountries.map((country) => country && (
        <a class="country-link" href={"/country/" + country.code + "/"} title={"Browse songs from " + country.nameEn}>
          <span class="country-code" aria-hidden="true">{country.code.toUpperCase()}</span>
          <span class="country-name">
            <strong>{country.nameEn}</strong>
            <small>{country.code.toUpperCase()}</small>
          </span>
          <i data-lucide="chevron-right"></i>
        </a>
      ))}
    </div>
  </section>

  <!-- Educational Guide & Long-Tail FAQ Section -->
  <section class="page-shell faq-section" id="faq">
    <div class="section-heading">
      <div>
        <p class="eyebrow"><i data-lucide="help-circle"></i> Music Knowledge & Attribution</p>
        <h2>Original Recordings & Cover Songs FAQ</h2>
        <p class="section-subtext">Everything you need to know about who sang it first, cover versions, and song history.</p>
      </div>
    </div>

    <div class="faq-grid">
      {faqList.map((faq) => (
        <div class="faq-card">
          <h3 class="faq-question">
            <i data-lucide="help-circle"></i> {faq.q}
          </h3>
          <p class="faq-answer">{faq.a}</p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
