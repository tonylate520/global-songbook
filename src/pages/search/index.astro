---
import BaseLayout from "../../layouts/BaseLayout.astro";

const popularQueries = [
  "Hallelujah",
  "Hotel California",
  "The Sound of Silence",
  "La Vie en rose",
  "I Will Always Love You",
  "Despacito",
  "House of the Rising Sun",
  "Yesterday",
  "Stand by Me",
  "Imagine"
];
---

<BaseLayout
  title="Search Songs, Artists & Cover Versions | Global Song Index"
  description="Search over 4,400 songs and 33,000 artists to find original performers, cover versions, and release years across 130+ countries."
  keywords="search songs, find who sang it first, cover versions search, artist search, song database search"
  noindex
>
  <div class="page-shell">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <i data-lucide="chevron-right"></i>
      <span>Search</span>
    </nav>

    <header class="page-header">
      <p class="eyebrow"><i data-lucide="search"></i> Catalogue Search</p>
      <h1>Search Songs & Artists</h1>
      <p class="lead">
        Enter a song title or artist name to find out who sang it first, discover international cover versions, and explore recordings by country.
      </p>
    </header>

    <section class="section">
      <form id="search-form" class="search-box">
        <i data-lucide="search"></i>
        <input
          id="search-input"
          name="q"
          type="search"
          minlength="2"
          placeholder="Search by song title, performer, or band (e.g. Hallelujah, Simon & Garfunkel)..."
          aria-label="Song or artist name"
          required
          autofocus
        />
        <button type="submit">
          <i data-lucide="search"></i> Search
        </button>
      </form>

      <!-- Popular Query Suggestions -->
      <div class="trending-searches" style="margin-top: 20px;">
        <span class="trending-label">
          <i data-lucide="sparkles"></i> Popular Suggestions:
        </span>
        <div class="trending-pills">
          {popularQueries.map((q) => (
            <button type="button" class="trending-pill suggestion-btn" data-query={q}>
              {q}
            </button>
          ))}
        </div>
      </div>

      <div class="search-status" style="min-height: 44px; padding: 20px 2px 12px; color: var(--muted); font-size: 14px; font-weight: 600;">
        <span id="search-summary">Type at least 2 characters to begin searching</span>
      </div>

      <div id="search-loading" class="loading-state hidden">
        <div>
          <i data-lucide="search"></i>
          <p>Searching the international catalogue...</p>
        </div>
      </div>

      <div id="search-empty" class="empty-state">
        <div>
          <i data-lucide="music-2"></i>
          <p>Enter a song or artist name to explore original performers and covers</p>
        </div>
      </div>

      <div id="search-results" class="data-table hidden">
        <div class="table-head">
          <span>Song Title</span>
          <span>Performing Artist & Country</span>
          <span>Credit Role</span>
          <span>View</span>
        </div>
        <div id="search-rows"></div>
      </div>
    </section>
  </div>
  <script>import "../../scripts/search-page";</script>
</BaseLayout>
