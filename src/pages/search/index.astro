---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Search songs and artists - Global Song Index" noindex>
  <div class="page-shell">
    <header class="page-header">
      <p class="eyebrow">Catalogue / Search</p>
      <h1>Search Songs & Artists</h1>
      <p class="lead">Search by a full name or the beginning of a song or artist name.</p>
    </header>
    <section class="section">
      <form id="search-form" class="search-box">
        <i data-lucide="search"></i>
        <input id="search-input" name="q" type="search" minlength="2" placeholder="Enter at least 2 characters" aria-label="Song or artist name" required />
        <button type="submit">Search</button>
      </form>
      <div class="search-status"><span id="search-summary">Ready to search</span></div>
      <div id="search-loading" class="loading-state hidden"><div><i data-lucide="search"></i><p>Searching</p></div></div>
      <div id="search-empty" class="empty-state"><div><i data-lucide="music-2"></i><p>Enter a song or artist name to begin</p></div></div>
      <div id="search-results" class="data-table hidden">
        <div class="table-head"><span>Song</span><span>Artist / Country</span><span>Credit</span><span></span></div>
        <div id="search-rows"></div>
      </div>
    </section>
  </div>
  <script>import "../../scripts/search-page";</script>
</BaseLayout>

<style>.search-status { min-height: 50px; padding: 18px 2px 10px; color: var(--muted); font-size: 13px; }</style>
